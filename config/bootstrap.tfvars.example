# Copy to config/bootstrap.tfvars and replace these values.
aws_region        = "REPLACE_WITH_AWS_REGION"
state_bucket_name = "REPLACE_WITH_GLOBALLY_UNIQUE_STATE_BUCKET"
github_org        = "REPLACE_WITH_GITHUB_ORG_OR_USERNAME"

# Usually keep these names unchanged unless your GitHub repositories use different names.
platform_repo = "platform-infra"
ami_repo      = "wordpress-ami"
workload_repo = "wordpress-infra"
